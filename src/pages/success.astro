---
import "../styles/global.css";

const url = new URL(Astro.url);
const provider = url.searchParams.get("provider") || "unknown";
const id = url.searchParams.get("id") || url.searchParams.get("session_id") || url.searchParams.get("paymentKey") || "—";
const mock = url.searchParams.get("mock") === "1";
const labels: Record<string, string> = {
  stripe: "Stripe",
  toss: "Toss Payments",
  portone: "PortOne (포트원)",
  kakao: "KakaoPay (mock)",
  naver: "NaverPay (mock)",
  unknown: "Unknown",
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Payment Success</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
  </head>
  <body class="min-h-screen grid place-items-center">
    <main class="w-full max-w-md px-6 py-12">
      <div class="rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-ink-soft)] p-8 lg:p-10 text-center">
        <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/15 grid place-items-center mb-6">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M5 13l4 4L19 7" stroke="rgb(52, 211, 153)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h1 class="text-2xl font-semibold tracking-[-0.02em]">결제 성공</h1>
        <p class="mt-3 text-sm text-[var(--color-fg-mute)]">{labels[provider] ?? provider}</p>
        {mock && (
          <p class="mt-4 inline-block text-[11px] uppercase tracking-[0.2em] px-3 py-1 rounded-full bg-amber-400/15 text-amber-300">Mock sandbox · 실제 결제 아님</p>
        )}
        <div class="mt-8 text-left bg-black/30 rounded-xl p-4 text-xs font-mono break-all">
          <div class="text-[var(--color-fg-mute)] mb-1">Payment ID</div>
          <div>{id}</div>
        </div>
        <a href="/" class="mt-8 inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white text-[var(--color-ink)] font-medium text-sm">
          쇼핑 계속하기 →
        </a>
      </div>
    </main>
  </body>
</html>
