---
import "../styles/global.css";

const url = new URL(Astro.url);
const provider = url.searchParams.get("provider") || "unknown";
const id = url.searchParams.get("id") || url.searchParams.get("session_id") || url.searchParams.get("paymentKey") || "—";
const mock = url.searchParams.get("mock") === "1";
const labels: Record<string, string> = {
  stripe: "Stripe",
  toss: "Toss Payments",
  kakao: "KakaoPay (mock)",
  naver: "NaverPay (mock)",
};
const label = labels[provider] ?? provider;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>결제 완료 · NSHOP</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
  </head>
  <body class="min-h-screen bg-[var(--color-bg-soft)]">
    <header class="bg-white border-b border-[var(--color-border)]">
      <div class="container-x flex items-center h-16">
        <a href="/" class="text-2xl font-bold">
          <span style="color: var(--color-naver)">N</span>SHOP
        </a>
      </div>
    </header>

    <main class="container-x py-10 lg:py-14 max-w-2xl">
      <div class="bg-white border border-[var(--color-border)] rounded p-8 lg:p-12 text-center">
        <div class="w-14 h-14 mx-auto rounded-full grid place-items-center mb-5" style="background:#e6f9ee;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <path d="M5 13l4 4L19 7" stroke="#03C75A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold">주문이 완료되었습니다</h1>
        <p class="mt-2 text-sm text-[var(--color-mute)]">결제 수단 · {label}</p>
        {mock && (
          <p class="mt-4 inline-block text-[11px] font-medium px-3 py-1 rounded bg-amber-50 text-amber-700 border border-amber-200">
            MOCK · 실제 결제 아님
          </p>
        )}

        <div class="mt-6 text-left border-t border-[var(--color-border)] pt-5">
          <div class="text-[12px] text-[var(--color-mute)] mb-1">주문/결제 번호</div>
          <div class="font-mono text-[13px] break-all">{id}</div>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="btn-naver px-5 py-2.5 text-sm font-semibold rounded">쇼핑 계속하기</a>
          <a href="#" class="px-5 py-2.5 text-sm border border-[var(--color-border-2)] rounded hover:bg-[var(--color-bg-soft)]">주문 내역</a>
        </div>
      </div>
    </main>
  </body>
</html>
