---
import "../styles/global.css";

const url = new URL(Astro.url);
const provider = url.searchParams.get("provider") || "unknown";
const message = url.searchParams.get("message") || url.searchParams.get("code") || "결제가 완료되지 않았습니다.";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>결제 실패 · NSHOP</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
  </head>
  <body class="min-h-screen bg-[var(--color-bg-soft)]">
    <header class="bg-white border-b border-[var(--color-border)]">
      <div class="container-x flex items-center h-16">
        <a href="/" class="text-2xl font-bold">
          <span style="color: var(--color-naver)">N</span>SHOP
        </a>
      </div>
    </header>

    <main class="container-x py-10 lg:py-14 max-w-2xl">
      <div class="bg-white border border-[var(--color-border)] rounded p-8 lg:p-12 text-center">
        <div class="w-14 h-14 mx-auto rounded-full grid place-items-center mb-5" style="background:#fef2f2;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <path d="M6 6l12 12M18 6L6 18" stroke="#e8334f" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold">결제에 실패했습니다</h1>
        <p class="mt-2 text-sm text-[var(--color-mute)]">{provider} · {message}</p>

        <div class="mt-8 flex justify-center gap-3">
          <a href="/" class="btn-naver px-5 py-2.5 text-sm font-semibold rounded">돌아가기</a>
        </div>
      </div>
    </main>
  </body>
</html>
